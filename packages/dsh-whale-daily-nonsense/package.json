{
  "name": "dsh-whale-daily-nonsense",
  "version": "0.2.0",
  "description": "An AI-generated daily nonsense quote with a shareable whale-girl card for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "daily",
    "quote",
    "whale",
    "ai",
    "llm"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "PUBLISHING.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.1 || 0.2.1-rc.2"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.1 <0.3.0"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "author": "suilian520",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suilian520/dsh-whale-plugins.git",
    "directory": "packages/dsh-whale-daily-nonsense"
  },
  "homepage": "https://github.com/suilian520/dsh-whale-plugins#readme",
  "bugs": {
    "url": "https://github.com/suilian520/dsh-whale-plugins/issues"
  }
}
